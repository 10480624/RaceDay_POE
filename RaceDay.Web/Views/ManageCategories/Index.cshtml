@model RaceDay.Web.Models.CategoryManagementViewModel

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Manage Categories</h1>
        <p class="text-muted mb-0">@Model.EventName</p>
    </div>

    <a asp-controller="ManageEvents"
       asp-action="Index"
       class="btn btn-secondary">
        Back to My Events
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h3 class="mb-3">Existing Categories</h3>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">
        No categories have been added to this event yet.
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Age Range</th>
                    <th>Distance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.CategoryName</td>
                        <td>@(category.AgeRange ?? "Not specified")</td>
                        <td>
                            @(category.Distance.HasValue
                                ? $"{category.Distance.Value} km"
                                : "Not specified")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<hr />

<h3 class="mb-3">Add a Category</h3>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EventId" />
    <input type="hidden" asp-for="NewCategory.EventId" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="NewCategory.CategoryName"
               class="form-label">Category Name</label>
        <input asp-for="NewCategory.CategoryName"
               class="form-control"
               placeholder="e.g. 10 km Open" />
        <span asp-validation-for="NewCategory.CategoryName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewCategory.AgeRange"
               class="form-label">Age Range</label>
        <input asp-for="NewCategory.AgeRange"
               class="form-control"
               placeholder="e.g. 18–35" />
        <span asp-validation-for="NewCategory.AgeRange"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewCategory.Distance"
               class="form-label">Distance (km)</label>
        <input asp-for="NewCategory.Distance"
               type="number"
               step="0.1"
               class="form-control" />
        <span asp-validation-for="NewCategory.Distance"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Add Category
    </button>
</form>