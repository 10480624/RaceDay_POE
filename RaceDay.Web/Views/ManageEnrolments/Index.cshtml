@model RaceDay.Web.Models.ManageEnrolmentsViewModel

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Event Enrolments</h1>
        <p class="text-muted mb-0">@Model.EventName</p>
    </div>

    <a asp-controller="ManageEvents"
       asp-action="Index"
       class="btn btn-secondary">
        Back to My Events
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Enrolments.Any())
{
    <div class="alert alert-info">
        No participants have enrolled in this event yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Enrolment ID</th>
                    <th>Participant ID</th>
                    <th>Category</th>
                    <th>Enrolment Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model.Enrolments)
                {
                    <tr>
                        <td>@enrolment.EnrolmentId</td>
                        <td>@enrolment.UserId</td>
                        <td>@enrolment.CategoryName</td>
                        <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="badge bg-secondary">
                                @enrolment.Status
                            </span>
                        </td>
                        <td>
                            @if (!string.Equals(
                                enrolment.Status,
                                "Completed",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <form asp-controller="ManageEnrolments"
                                      asp-action="Complete"
                                      method="post">
                                    <input type="hidden"
                                           name="eventId"
                                           value="@Model.EventId" />
                                    <input type="hidden"
                                           name="enrolmentId"
                                           value="@enrolment.EnrolmentId" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        Mark Completed
                                    </button>
                                </form>
                            }
                            else if (enrolment.ResultId == null)
                            {
                                <a asp-controller="Results"
                                   asp-action="Create"
                                   asp-route-eventId="@Model.EventId"
                                   asp-route-enrolmentId="@enrolment.EnrolmentId"
                                   class="btn btn-sm btn-primary">
                                    Add Result
                                </a>
                            }
                            else
                            {
                                <span class="text-success">Result Recorded</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}