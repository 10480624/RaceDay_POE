@model RaceDay.Web.Models.ManageEnrolmentsViewModel

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="page-heading mb-4">
    <div>
        <h1>Event Enrolments</h1>
        <p class="text-secondary mb-0">@Model.EventName</p>
    </div>
    <a asp-controller="ManageEvents" asp-action="Index" class="btn btn-outline-secondary">
        Back to My Events
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="content-panel">
@if (!Model.Enrolments.Any())
{
    <div class="empty-state">
        <h4>No participants enrolled</h4>
        <p class="text-secondary mb-0">Enrolments will appear here when participants register.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Enrolment</th>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var enrolment in Model.Enrolments)
            {
                var statusClass = enrolment.Status?.ToLowerInvariant() switch
                {
                    "completed" => "status-completed",
                    "cancelled" => "status-cancelled",
                    _ => "status-pending"
                };

                <tr>
                    <td>#@enrolment.EnrolmentId</td>
                    <td>@enrolment.UserId</td>
                    <td>@enrolment.CategoryName</td>
                    <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-badge @statusClass">@enrolment.Status</span></td>
                    <td>
                    @if (!string.Equals(enrolment.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                    {
                        <form asp-controller="ManageEnrolments" asp-action="Complete" method="post">
                            <input type="hidden" name="eventId" value="@Model.EventId" />
                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentId" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Mark Completed</button>
                        </form>
                    }
                    else if (enrolment.ResultId == null)
                    {
                        <a asp-controller="Results" asp-action="Create"
                           asp-route-eventId="@Model.EventId"
                           asp-route-enrolmentId="@enrolment.EnrolmentId"
                           class="btn btn-sm btn-primary">Add Result</a>
                    }
                    else
                    {
                        <span class="text-success small fw-semibold">Result recorded</span>
                    }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>