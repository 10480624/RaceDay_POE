@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="page-heading mb-4">
    <div>
        <h1>Upcoming Events</h1>
        <p class="text-secondary">Find an event and take part.</p>
    </div>
</div>

<div class="filter-panel mb-4">
    <div class="row g-3">
        <div class="col-md-5">
            <label for="eventSearch" class="form-label">Search events</label>
            <input id="eventSearch" class="form-control"
                   placeholder="Search by event or location..." />
        </div>
        <div class="col-md-3">
            <label for="typeFilter" class="form-label">Event type</label>
            <select id="typeFilter" class="form-select">
                <option value="">All types</option>
                <option value="run">Running</option>
                <option value="walk">Walking</option>
                <option value="cycle">Cycling</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="dateFilter" class="form-label">Date</label>
            <select id="dateFilter" class="form-select">
                <option value="all">All dates</option>
                <option value="upcoming">Upcoming only</option>
            </select>
        </div>
    </div>
    <p class="small text-secondary mt-3 mb-0">
        Showing <span id="resultCount">@Model.Count</span> event(s).
    </p>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h4>No events available</h4>
        <p class="text-secondary mb-0">Please check again later.</p>
    </div>
}
else
{
    <div class="row g-4" id="eventList">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 event-item"
                 data-name="@item.Name.ToLowerInvariant()"
                 data-location="@item.Location.ToLowerInvariant()"
                 data-type="@item.EventType.ToLowerInvariant()"
                 data-date="@item.EventDate.ToString("yyyy-MM-dd")">
                <div class="card event-card h-100">
                    <div class="card-body d-flex flex-column">
                        <span class="event-type-label">@item.EventType</span>
                        <h5 class="mt-3">@item.Name</h5>
                        <p class="text-secondary">@item.Description</p>

                        <div class="event-details mt-auto">
                            <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.Distance km</p>
                        </div>

                        <a asp-action="Details" asp-route-id="@item.EventId"
                           class="btn btn-primary w-100 mt-3">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noMatches" class="empty-state mt-3" hidden>
        <h4>No matching events</h4>
        <p class="text-secondary mb-0">Try changing your search or filters.</p>
    </div>
}

@section Scripts {
<script>
    const search = document.getElementById("eventSearch");
    const type = document.getElementById("typeFilter");
    const date = document.getElementById("dateFilter");
    const items = Array.from(document.querySelectorAll(".event-item"));

    function filterEvents() {
        const term = search.value.trim().toLowerCase();
        const selectedType = type.value.toLowerCase();
        const upcomingOnly = date.value === "upcoming";
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        let count = 0;

        items.forEach(item => {
            const matchesText =
                item.dataset.name.includes(term) ||
                item.dataset.location.includes(term);

            const matchesType =
                !selectedType || item.dataset.type === selectedType;

            const eventDate = new Date(item.dataset.date + "T00:00:00");
            const matchesDate = !upcomingOnly || eventDate >= today;

            const visible = matchesText && matchesType && matchesDate;
            item.hidden = !visible;

            if (visible) count++;
        });

        document.getElementById("resultCount").textContent = count;
        document.getElementById("noMatches").hidden = count !== 0;
    }

    search.addEventListener("input", filterEvents);
    type.addEventListener("change", filterEvents);
    date.addEventListener("change", filterEvents);
</script>
}