@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Upcoming Race Events</h1>
        <p class="text-muted">Discover and explore available RaceDay events.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No events are currently available.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>

                        <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy HH:mm")</p>
                        <p><strong>Location:</strong> @item.Location</p>
                        <p><strong>Distance:</strong> @item.Distance km</p>
                        <p><strong>Type:</strong> @item.EventType</p>

                        <a asp-action="Details"
                           asp-route-id="@item.EventId"
                           class="btn btn-primary">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}