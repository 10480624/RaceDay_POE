@model List<RaceDay.Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Manage My Events</h1>
    <a asp-action="Create" class="btn btn-primary">Create New Event</a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't created any events yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@item.Location</td>
                        <td>@item.Distance km</td>
                        <td>@item.EventType</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-action="Edit"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-controller="ManageCategories"
                                   asp-action="Index"
                                   asp-route-eventId="@item.EventId"
                                   class="btn btn-sm btn-info">
                                    Categories
                                </a>

                                <a asp-controller="ManageEnrolments"
                                   asp-action="Index"
                                   asp-route-eventId="@item.EventId"
                                   class="btn btn-sm btn-success">
                                    Enrolments
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.EventId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this event?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}